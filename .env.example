# Copy to a private environment configuration. Never commit real values.
AUTH0_ISSUER=https://YOUR_AUTH0_TENANT/
AUTH0_AUDIENCE=YOUR_AUTH0_API_IDENTIFIER
AUTH0_ALLOWED_CLIENT_IDS=YOUR_AUTH0_APPLICATION_CLIENT_ID
# Exact browser origins, comma-separated. These are NOT Auth0 client IDs.
ALLOWED_ORIGINS=https://YOUR_DASHBOARD_ORIGIN
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
